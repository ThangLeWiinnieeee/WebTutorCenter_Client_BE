# ─────────────── Server ───────────────
PORT=5002
# Đặt "production" khi deploy lên Render (bật Secure + SameSite=Lax cho cookie)
NODE_ENV=development

# Nhiều origin phân tách bằng dấu phẩy. Khi deploy thêm domain FE trên Vercel.
# vd: http://localhost:4000,https://app.tenmien.com
CLIENT_URL=http://localhost:4000

# Chỉ đặt khi FE + BE cùng domain cha (app.tenmien.com ↔ api.tenmien.com).
# Giá trị bắt đầu bằng dấu chấm để cookie refresh dùng chung mọi subdomain.
# vd: .tenmien.com   — bỏ trống ở localhost.
COOKIE_DOMAIN=

# ─────────────── Database ───────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ─────────────── JWT ───────────────
ACCESS_TOKEN_SECRET=your-access-token-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ─────────────── Google OAuth ───────────────
# Dùng cho Gmail API (gửi OTP) + fallback cho đăng nhập Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Client ID để VERIFY token đăng nhập Google — PHẢI trùng VITE_GOOGLE_CLIENT_ID của FE.
# Bỏ trống nếu FE + Gmail dùng chung 1 client (khi đó fallback về GOOGLE_CLIENT_ID).
GOOGLE_LOGIN_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ─────────────── Email (Gmail API + OAuth2 - HTTPS, không bị host chặn cổng SMTP) ───────────────
# Tài khoản Gmail dùng để gửi (phải là tài khoản đã cấp quyền khi lấy refresh token)
GMAIL_USER=your-email@gmail.com
# Lấy bằng: node scripts/getGmailRefreshToken.js (chạy 1 lần)
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
# Tên hiển thị + email gửi (mặc định lấy GMAIL_USER nếu bỏ trống)
EMAIL_FROM=WebTutorCenter <your-email@gmail.com>
# Dùng lại GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET ở mục Google OAuth phía trên

# ─────────────── Cloudinary (upload ảnh) ───────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─────────────── Chatbot service (FastAPI riêng, xem ../chatbot-service) ───────────────
# BE proxy câu hỏi người dùng sang POST {CHATBOT_URL}/api/chat
CHATBOT_URL=http://localhost:8001
# Secret nội bộ BE ↔ chatbot; PHẢI trùng INTERNAL_SECRET của chatbot-service (bỏ trống nếu chatbot không đặt)
CHATBOT_INTERNAL_SECRET=
# Timeout (ms) khi gọi chatbot
CHATBOT_TIMEOUT_MS=20000
# Rate limit /api/chatbot chống spam đốt quota LLM (theo IP). Bỏ trống = mặc định 20 req/60s
CHATBOT_RATE_WINDOW_MS=60000
CHATBOT_RATE_MAX=20

# ─────────────── VNPay (thanh toán phí nhận lớp cho gia sư) ───────────────
# Đăng ký sandbox tại https://sandbox.vnpayment.vn để lấy TmnCode + HashSecret.
VNP_TMN_CODE=your-vnpay-tmncode
VNP_HASH_SECRET=your-vnpay-hashsecret
# URL cổng thanh toán (mặc định sandbox nếu bỏ trống)
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Ghi chú: URL redirect về được BE tự dựng theo host của request
# (<protocol>://<host>/api/payments/:provider/return) nên không cần cấu hình thêm.
# Cổng chỉ hiện cho gia sư chọn khi ĐÃ điền đủ credential của cổng đó.

# ─────────────── MoMo (sandbox) ───────────────
# Lấy tại https://business.momo.vn / tài liệu test MoMo (partnerCode/accessKey/secretKey)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Endpoint tạo đơn (mặc định sandbox nếu bỏ trống)
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ─────────────── ZaloPay (sandbox) ───────────────
# Lấy tại https://sandbox.zalopay.vn (app_id/key1/key2)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
# Endpoint tạo đơn + truy vấn (mặc định sandbox nếu bỏ trống)
ZALOPAY_CREATE_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query
